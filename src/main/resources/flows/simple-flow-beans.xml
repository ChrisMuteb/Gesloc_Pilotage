<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation=" http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="pilotageFormAction" class="com.example.webflow.action.PilotageFormAction">
        <property name="formObjectName" value="pilotageForm" />
        <property name="formObjectClass" value="com.example.webflow.dto.PilotageForm" />
        <property name="formObjectScope" value="FLOW" />
        <property name="formErrorsScope" value="REQUEST" />
    </bean>
</beans>