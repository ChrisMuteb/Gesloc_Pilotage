<?xml version="1.0" encoding="UTF-8"?>
<flow xmlns="http://www.springframework.org/schema/webflow"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.springframework.org/schema/webflow
        http://www.springframework.org/schema/webflow/spring-webflow-2.4.xsd"
      start-state="home">

    <view-state id="home" view="home">
        <on-render>
            <evaluate expression="pilotageFormAction.setupForm" />
        </on-render>
        <transition on="listemensuelle" to="listemensuelle"/>
    </view-state>

    <action-state id="listemensuelle">

        <evaluate expression="pilotageFormAction.sumbmitDemande" />
        <transition on="success" to=""/>
        <transition on="error" to=""/>
    </action-state>

</flow>